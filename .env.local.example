# Vercel and Next.js environment variables
# Rename this file to .env.local and fill in your actual values.
# Do NOT commit .env.local to your repository.

# Gemini API Key (used by chat, proposal, gig, ads-optimizer APIs)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Calendar API (used by app/api/calendar/route.js)
# For production, it's highly recommended to implement a full OAuth 2.0 flow 
# to obtain and refresh tokens rather than using a long-lived access token.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_ACCESS_TOKEN=your_google_access_token_here # Primarily for testing/development if not using full OAuth flow
# You will also need a GOOGLE_REDIRECT_URI if you implement the full OAuth flow.
# Example: GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback (local)
#           GOOGLE_REDIRECT_URI=https://your-site.vercel.app/api/auth/google/callback (production)


# GitHub Personal Access Token (PAT) (used by lib/github.js for Octokit)
# Must have 'repo' scope (full control of private repositories if your repo is private, or public_repo for public ones).
GITHUB_TOKEN=your_github_personal_access_token_here
# IMPORTANT: Remember to update owner/repo placeholders in `lib/github.js`
# e.g., const defaultRepoOwner = 'your-actual-github-username';
#       const defaultRepoName = 'your-actual-repo-name';

# Prisma Database URL (matches prisma/schema.prisma datasource.db.url)
# For SQLite, this points to a local file relative to the prisma schema file.
DATABASE_URL="file:./dev.db"

# Mailchimp API Key (optional, for Email Responder tool if you implement it)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Base URL for your application (can be useful for API calls from server-side, or for metadata, OAuth redirects)
# For Vercel deployments, Vercel automatically sets NEXT_PUBLIC_VERCEL_URL (for client-side) and VERCEL_URL (server-side).
# For local development, you might set it to http://localhost:3000
# NEXT_PUBLIC_BASE_URL=http://localhost:3000 
# APP_BASE_URL=http://localhost:3000 # For server-side use if needed

# Add any other application-specific environment variables here.
