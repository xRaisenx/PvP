        let payments = [
            { id: "PY-2024-001", client: "JULMAR", date: "2024-01-10", amount: 1500.00, method: "bank_transfer", status: "completed", reference: "BT-2024-001" },
            { id: "PY-2024-002", client: "FreshMart Supermarket", date: "2024-01-18", amount: 2000.00, method: "bank_transfer", status: "completed", reference: "BT-2024-002" },
            { id: "PY-2024-003", client: "Tropical Delights", date: "2024-01-12", amount: 1800.00, method: "bank_transfer", status: "completed", reference: "BT-2024-003" },
