            <div class="p-6 border-b">
                <div class="flex justify-between items-center">
                    <h2 id="clientModalTitle" class="text-xl font-bold text-gray-900">Client Details</h2>
                    <button onclick="closeModal('clientModal')" class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            
            <div class="p-6">
                <div id="clientDetails" class="space-y-6">
                    <!-- Client details will be populated by JavaScript -->
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Processing Modal -->
    <div id="paymentModal" class="modal">
        <div class="modal-content fade-in">
            <div class="p-6 border-b">
