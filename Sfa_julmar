                                    class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition-colors"
                                    title="View Details">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button onclick="openPaymentModal(${client.id})"
                                    class="p-2 text-green-600 hover:bg-green-100 rounded-lg transition-colors"
                                    title="Process Payment">
                                <i class="fas fa-money-bill-wave"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        // Render orders table
        function renderOrders() {
            ordersTable.innerHTML = orders.map(order => `
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 font-medium text-gray-900">${order.id}</td>
                    <td class="px-6 py-4 text-gray-900">${order.client}</td>
                    <td class="px-6 py-4 text-gray-700">${order.date}</td>
                    <td class="px-6 py-4 font-medium text-gray-900">$${order.amount.toFixed(2)}</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                            order.status === 'paid' ? 'bg-green-100 text-green-800' :
                            order.status === 'partial_paid' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-red-100 text-red-800'
                        }">
                            ${order.status === 'paid' ? 'Paid' :
                              order.status === 'partial_paid' ? 'Partial Payment' : 'Pending Payment'}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <button onclick="openClientDetails(${clients.find(c => c.name === order.client)?.id})"
                                class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                            View Client
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        // Render payments table
        function renderPayments() {
            paymentsTable.innerHTML = payments.map(payment => `
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 font-medium text-gray-900">${payment.id}</td>
                    <td class="px-6 py-4 text-gray-900">${payment.client}</td>
                    <td class="px-6 py-4 text-gray-700">${payment.date}</td>
                    <td class="px-6 py-4 font-medium text-green-600">$${payment.amount.toFixed(2)}</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                            payment.method === 'bank_transfer' ? 'bg-blue-100 text-blue-800' :
                            payment.method === 'cash' ? 'bg-green-100 text-green-800' :
                            payment.method === 'check' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-purple-100 text-purple-800'
                        }">
                            ${payment.method === 'bank_transfer' ? 'Bank Transfer' :
                              payment.method === 'cash' ? 'Cash' :
                              payment.method === 'check' ? 'Check' : 'Credit Card'}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Completed
                        </span>
                    </td>
                </tr>
            `).join('');
        }

        // Filter clients
        function filterClients() {
            renderClients();
        }

        // Update statistics
        function updateStats() {
            totalClientsEl.textContent = clients.length;
            
            const totalRevenue = orders.reduce((sum, order) => sum + order.amount, 0);
            totalRevenueEl.textContent = `$${totalRevenue.toFixed(2)}`;
            
            const overdueCount = clients.filter(c => c.outstanding > 0).length;
            overduePaymentsEl.textContent = overdueCount;
            
            const creditHoldCount = clients.filter(c => c.status === 'credit_hold').length;
            creditHoldEl.textContent = creditHoldCount;
        }

        // Open modals
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Open client details
        function openClientDetails(clientId) {
            const client = clients.find(c => c.id === clientId);
            if (!client) return;

            const clientDetails = document.getElementById('clientDetails');
            clientDetails.innerHTML = `
                <div class="border-b pb-4">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">${client.name}</h3>
                            <p class="text-gray-600">${client.contact}</p>
                            <p class="text-gray-600">${client.phone}</p>
                        </div>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                            client.status === 'credit_hold' ? 'bg-red-100 text-red-800' :
                            client.status === 'warning' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-green-100 text-green-800'
                        }">
                            ${client.status === 'credit_hold' ? 'Credit Hold' :
                              client.status === 'warning' ? 'Payment Warning' : 'Active'}
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 class="font-semibold text-gray-900 mb-3">Account Information</h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Address:</span>
                                <span class="text-gray-900">${client.address}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Account Manager:</span>
                                <span class="text-gray-900">${client.accountManager}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Payment Terms:</span>
                                <span class="text-gray-900">${client.paymentTerms}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Last Payment:</span>
                                <span class="text-gray-900">${client.lastPayment}</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h4 class="font-semibold text-gray-900 mb-3">Financial Summary</h4>
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between">
                                <span class="text-gray-600">Credit Limit:</span>
                                <span class="text-gray-900">$${client.creditLimit.toFixed(2)}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Credit Used:</span>
                                <span class="text-gray-900">$${client.creditUsed.toFixed(2)}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Outstanding Balance:</span>
                                <span class="text-red-600 font-medium">$${client.outstanding.toFixed(2)}</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-600">Credit Utilization:</span>
                                <span class="text-gray-900">${((client.creditUsed / client.creditLimit) * 100).toFixed(1)}%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <h4 class="font-semibold text-gray-900 mb-3">Payment History</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-3 py-2 text-left">Date</th>
                                    <th class="px-3 py-2 text-left">Amount</th>
                                    <th class="px-3 py-2 text-left">Method</th>
                                    <th class="px-3 py-2 text-left">Reference</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                ${client.paymentHistory.map(p => `
                                    <tr>
                                        <td class="px-3 py-2">${p.date}</td>
                                        <td class="px-3 py-2">$${p.amount.toFixed(2)}</td>
                                        <td class="px-3 py-2 capitalize">${p.method.replace('_', ' ')}</td>
                                        <td class="px-3 py-2">${p.reference}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div>
                    <h4 class="font-semibold text-gray-900 mb-3">Recent Orders</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-3 py-2 text-left">Order #</th>
                                    <th class="px-3 py-2 text-left">Date</th>
                                    <th class="px-3 py-2 text-left">Amount</th>
                                    <th class="px-3 py-2 text-left">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                ${client.orders.map(o => `
                                    <tr>
                                        <td class="px-3 py-2">${o.id}</td>
                                        <td class="px-3 py-2">${o.date}</td>
                                        <td class="px-3 py-2">$${o.amount.toFixed(2)}</td>
                                        <td class="px-3 py-2">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium ${
                                                o.status === 'paid' ? 'bg-green-100 text-green-800' :
                                                o.status === 'partial_paid' ? 'bg-yellow-100 text-yellow-800' :
                                                'bg-red-100 text-red-800'
                                            }">
                                                ${o.status === 'paid' ? 'Paid' :
                                                  o.status === 'partial_paid' ? 'Partial Payment' : 'Pending Payment'}
                                            </span>
                                        </td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>

                ${client.name === 'JULMAR' ? `
                <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <div class="flex">
                        <i class="fas fa-exclamation-triangle text-red-500 mt-1"></i>
                        <div class="ml-3">
                            <h4 class="text-sm font-medium text-red-800">Urgent Payment Alert</h4>
                            <p class="text-sm text-red-700">Client JULMAR has overdue payments totaling $2,850.00 from the last 3 months. Partial payment received 2 months ago, no payment last month. Immediate action required.</p>
                            <div class="mt-2">
                                <button onclick="openPaymentModal(${client.id}); closeModal('clientModal')"
                                        class="text-sm bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded">
                                    Process Payment
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                ` : ''}
            `;

            openModal('clientModal');
        }

        // Open payment modal
        function openPaymentModal(clientId) {
            const client = clients.find(c => c.id === clientId);
            if (!client) return;

            document.getElementById('paymentClientId').value = client.id;
            document.getElementById('paymentClientName').value = client.name;
            document.getElementById('paymentAmountDue').value = `$${client.outstanding.toFixed(2)}`;
            document.getElementById('paymentDate').valueAsDate = new Date();
            
            openModal('paymentModal');
        }

        // Process payment
        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const clientId = parseInt(document.getElementById('paymentClientId').value);
            const client = clients.find(c => c.id === clientId);
            if (!client) return;

            const paymentAmount = parseFloat(document.getElementById('paymentAmount').value);
            const paymentDate = document.getElementById('paymentDate').value;
            const paymentMethod = document.getElementById('paymentMethod').value;
            const paymentNotes = document.getElementById('paymentNotes').value;

            if (paymentAmount <= 0 || paymentAmount > client.outstanding) {
                alert('Payment amount must be greater than 0 and not exceed the outstanding balance.');
                return;
            }

            // Create new payment record
            const newPayment = {
                id: `PY-${new Date().getFullYear()}-${payments.length + 1}`,
                client: client.name,
                date: paymentDate,
                amount: paymentAmount,
                method: paymentMethod,
                status: 'completed',
                reference: `${paymentMethod.substring(0,3).toUpperCase()}-${new Date().getFullYear()}-${payments.length + 1}`
            };

            payments.unshift(newPayment);

            // Update client balance
            client.outstanding = Math.max(0, client.outstanding - paymentAmount);
            client.creditUsed = client.creditLimit - client.outstanding;
            client.lastPayment = paymentDate;

            // Add to payment history
            client.paymentHistory.unshift({
                date: paymentDate,
                amount: paymentAmount,
                method: paymentMethod,
                reference: newPayment.reference
            });

            // Check if client should be removed from credit hold
            if (client.status === 'credit_hold' && client.outstanding <= 0) {
                client.status = 'active';
            }

            // Update UI
            closeModal('paymentModal');
            renderClients();
            renderPayments();
            updateStats();

            // Show success message
            alert(`Payment of $${paymentAmount.toFixed(2)} processed successfully for ${client.name}.`);
        });

        // Notifications
        notificationsBtn.addEventListener('click', function() {
            openModal('notificationModal');
        });

        // Initialize the app
        init();
    </script>
</body>
</html>
