                            </tr>
                        </thead>
                        <tbody id="ordersTable" class="divide-y divide-gray-200">
                            <!-- Table content will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Payments Tab -->
