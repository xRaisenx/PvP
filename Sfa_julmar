                            ${client.status === 'credit_hold' ? 'Credit Hold' :
                              client.status === 'warning' ? 'Payment Warning' : 'Active'}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-gray-900">${client.totalOrders}</td>
                    <td class="px-6 py-4 font-medium ${
                        client.outstanding > 0 ? 'text-red-600' : 'text-green-600'
